{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept-Encoding"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'sha256-CJztG9Mx8Viy9CjdVQbWZChHJImD6oy0dbcqeAEBzis=' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data:; font-src 'self' data: https://fonts.gstatic.com; media-src 'self'; connect-src 'self' https://dcgjpknwhociepmakuyz.supabase.co https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/produtos",
      "destination": "/produtos.html"
    },
    {
      "source": "/produtos/organizador",
      "destination": "/produto-organizador"
    },
    {
      "source": "/produtos/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/equipamentos",
      "destination": "/equipamentos.html"
    },
    {
      "source": "/produtos/organizador-cofre-simples",
      "destination": "/produto-organizador-cofre-simples"
    },
    {
      "source": "/produtos/organizador-cofre-premium",
      "destination": "/produto-organizador-cofre-premium"
    },
    {
      "source": "/produtos/:slug",
      "destination": "/produto"
    },
    {
      "source": "/duvidas",
      "destination": "/duvidas.html"
    },
    {
      "source": "/sobre-nos",
      "destination": "/sobre-nos.html"
    },
    {
      "source": "/politica-de-privacidade",
      "destination": "/politica-de-privacidade.html"
    },
    {
      "source": "/politica-de-devolucao-e-reembolso",
      "destination": "/politica-de-devolucao-e-reembolso.html"
    },
    {
      "source": "/politica-de-frete",
      "destination": "/politica-de-frete.html"
    },
    {
      "source": "/politica-de-pos-venda",
      "destination": "/politica-de-pos-venda.html"
    },
    {
      "source": "/politica-de-cookies",
      "destination": "/politica-de-cookies.html"
    },
    {
      "source": "/termos-de-uso",
      "destination": "/termos-de-uso.html"
    }
  ],
  "redirects": [
    {
      "source": "/produtos",
      "destination": "/equipamentos",
      "permanent": false
    },
    {
      "source": "/produtos/organizador-tatico-com-cofre",
      "destination": "/equipamentos",
      "permanent": false
    },
    {
      "source": "/produtos/organizador-tatico",
      "destination": "/produtos/organizador",
      "permanent": false
    }
  ]
}
